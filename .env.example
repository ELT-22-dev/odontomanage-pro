# Copy this file to .env and fill in the values for this clinic's Supabase
# project (Settings -> API in the Supabase dashboard). See docs/IMPLANTACAO.md
# for the full setup guide.

VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_AQUI

# Optional — only needed for the Google Calendar sync (docs/IMPLANTACAO.md step 4).
# Without it the rest of the app works normally; the "Conectar Google Calendar"
# button just won't do anything.
VITE_GOOGLE_CLIENT_ID=SEU_CLIENT_ID_AQUI.apps.googleusercontent.com

# NOT needed here — the Anthropic API key used by the AI assistant is a secret
# and lives only as a Supabase Edge Function secret (docs/IMPLANTACAO.md step 3),
# never in this file or anywhere the browser can read it.
